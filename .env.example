# Copie para .env e preencha. Nunca versione o .env real.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=hotel
POSTGRES_PASSWORD=troque-por-uma-senha-local
POSTGRES_DB=hotel
POSTGRES_PORT=5433

# Usado pelo Prisma e pela aplicação.
DATABASE_URL="postgresql://hotel:troque-por-uma-senha-local@localhost:5433/hotel?schema=public"

# --- Primeiro administrador (usado só por "npm run db:seed") ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# --- Rede local ---
# IPs de outros aparelhos que acessam o modo desenvolvimento (separados por vírgula).
ALLOWED_DEV_ORIGINS=
# Coloque 1 quando o sistema rodar com HTTPS (Fase 7).
COOKIE_SECURE=0

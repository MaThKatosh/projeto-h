{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sistema do Hotel",
  "version": "1.0.0",
  "identifier": "br.com.projetoh.hotel",
  "build": {
    "frontendDist": "../../conectar"
  },
  "app": {
    "windows": [
      {
        "title": "Sistema do Hotel",
        "width": 1280,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Sistema do Hotel",
    "longDescription": "Recepção, governança, manutenção, restaurante e mais, conectado ao servidor do hotel."
  }
}

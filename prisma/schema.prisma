// Schema do Projeto H (sistema hoteleiro).
// Migrations versionadas em prisma/migrations — nunca editar uma
// migration já aplicada; criar uma nova.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================================================
// USUÁRIOS E CARGOS (Fase 1)
// ================================================================
//
// O que cada cargo pode fazer fica em lib/permissions.ts (código), não
// no banco: assim a regra é testada e não muda sem querer.

enum Role {
  ADMIN       // Administrador: tudo, inclusive usuários
  GERENTE     // Gerente: tudo da operação
  RECEPCAO    // Recepção: hóspedes, reservas, contas
  GOVERNANCA  // Governança: limpeza dos quartos
  MANUTENCAO  // Manutenção: problemas e bloqueios
  RESTAURANTE // Restaurante e frigobar
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  // Login por nome de usuário: nem todo funcionário tem e-mail.
  username     String   @unique
  fullName     String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  sessions      AuthSession[]
  auditLogs     AuditLog[]
  roomChanges   RoomStatusLog[]

  cleaningAssigned  CleaningTask[]      @relation("CleaningAssigned")
  cleaningFinished  CleaningTask[]      @relation("CleaningFinished")
  ticketsReported   MaintenanceTicket[] @relation("TicketReporter")
  ticketsAssigned   MaintenanceTicket[] @relation("TicketAssignee")
  ticketEvents      TicketEvent[]

  reservationsCreated Reservation[]      @relation("ReservationCreator")
  reservationEvents   ReservationEvent[]
  roomMoves           RoomMove[]
  folioPosted         FolioEntry[]       @relation("FolioPoster")
  folioReversed       FolioEntry[]       @relation("FolioReverser")
  comandasOpened      Comanda[]          @relation("ComandaOpener")
  comandasClosed      Comanda[]          @relation("ComandaCloser")
  comandaItems        ComandaItem[]
  posPayments         PosPayment[]
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  // O cookie leva o token; aqui fica só o hash dele.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Trilha de tudo que é sensível (login, usuários, cadastros). Base dos
// relatórios de auditoria das fases seguintes.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ================================================================
// QUARTOS (Fase 1)
// ================================================================
//
// Cada quarto tem TRÊS situações independentes, e cada setor mexe só na
// sua. A cor do mapa é calculada a partir delas (lib/rooms/status.ts).

enum Occupancy {
  LIVRE
  OCUPADO
}

enum Housekeeping {
  LIMPO
  SUJO
  EM_ARRUMACAO
}

enum Maintenance {
  OK
  COM_PROBLEMA
  EM_MANUTENCAO
  BLOQUEADO
}

model RoomType {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique // ex.: "Standard Casal"
  capacity    Int     @default(2)
  description String?

  rooms        Room[]
  prices       RatePrice[]
  reservations Reservation[]
}

model Room {
  id           String       @id @default(uuid()) @db.Uuid
  number       String       @unique // "101", "204A"
  floor        Int
  roomTypeId   String       @db.Uuid
  occupancy    Occupancy    @default(LIVRE)
  housekeeping Housekeeping @default(LIMPO)
  maintenance  Maintenance  @default(OK)
  // Observação curta visível no mapa (ex.: "chuveiro pingando").
  note         String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  roomType RoomType            @relation(fields: [roomTypeId], references: [id])
  history  RoomStatusLog[]
  cleanings CleaningTask[]
  reservations Reservation[]
  movesFrom    RoomMove[]   @relation("MoveFrom")
  movesTo      RoomMove[]   @relation("MoveTo")
  tickets   MaintenanceTicket[]

  @@index([floor, number])
}

// Histórico de cada mudança de situação de um quarto (quem, quando, de
// quê para quê). Alimenta os relatórios de governança e manutenção.
model RoomStatusLog {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  userId    String?  @db.Uuid
  field     String   // "housekeeping" | "maintenance" | "occupancy" | "note"
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([createdAt])
}

// ================================================================
// GOVERNANÇA (Fase 2)
// ================================================================
//
// Toda vez que um quarto fica SUJO nasce uma tarefa de limpeza. Começar
// a tarefa deixa o quarto EM_ARRUMACAO; terminar deixa LIMPO. A tarefa
// guarda quem arrumou e quanto tempo levou (relatórios da Fase 6).
// Regra garantida no banco: no máximo UMA tarefa aberta por quarto
// (índice parcial criado na migration).

enum CleaningStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model CleaningTask {
  id           String         @id @default(uuid()) @db.Uuid
  roomId       String         @db.Uuid
  status       CleaningStatus @default(PENDENTE)
  priority     Boolean        @default(false)
  assignedToId String?        @db.Uuid
  finishedById String?        @db.Uuid
  createdAt    DateTime       @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  room       Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("CleaningAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  finishedBy User? @relation("CleaningFinished", fields: [finishedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([finishedAt])
  @@index([roomId, createdAt])
}

// ================================================================
// MANUTENÇÃO (Fase 2)
// ================================================================
//
// Ocorrência = um problema a resolver, num quarto ou numa área do hotel
// (piscina, recepção...). A situação de manutenção do QUARTO é calculada
// a partir das ocorrências abertas dele (lib/maintenance/rules.ts).

enum TicketStatus {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO // peça, terceiro, hóspede sair...
  RESOLVIDA
  CANCELADA
}

enum TicketPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model MaintenanceTicket {
  id           String         @id @default(uuid()) @db.Uuid
  // Número curto para falar no rádio: "ocorrência 12".
  number       Int            @unique @default(autoincrement())
  roomId       String?        @db.Uuid
  location     String?        // quando não é num quarto
  title        String
  description  String?
  priority     TicketPriority @default(MEDIA)
  status       TicketStatus   @default(ABERTA)
  // Enquanto aberta, o quarto não pode ser vendido.
  outOfOrder   Boolean        @default(false)
  reportedById String?        @db.Uuid
  assignedToId String?        @db.Uuid
  resolution   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  startedAt    DateTime?
  closedAt     DateTime?

  room       Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reportedBy User?         @relation("TicketReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedTo User?         @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  events     TicketEvent[]

  @@index([status])
  @@index([roomId, status])
  @@index([closedAt])
}

// Linha do tempo da ocorrência (quem fez o quê e quando).
model TicketEvent {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  userId    String?  @db.Uuid
  type      String   // criada | atribuida | iniciada | aguardando | resolvida | cancelada | reaberta | comentario | fora_de_venda
  message   String?
  createdAt DateTime @default(now())

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

// ================================================================
// CONFIGURAÇÕES DO HOTEL (Fase 3)
// ================================================================
//
// Chave/valor. "businessDate" = DATA DO SISTEMA (data hoteleira): só
// muda na auditoria noturna (Fase 6), não à meia-noite do relógio.

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ================================================================
// HÓSPEDES, TARIFAS E RESERVAS (Fase 3)
// ================================================================
//
// Dinheiro sempre em CENTAVOS (Int). Datas de estadia em @db.Date
// (sem hora): entrada e saída; noites = saída - entrada.

model Guest {
  id          String    @id @default(uuid()) @db.Uuid
  fullName    String
  docType     String?   // CPF | RG | PASSAPORTE | OUTRO
  docNumber   String?
  phone       String?
  email       String?
  birthDate   DateTime? @db.Date
  nationality String?
  city        String?
  state       String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reservations Reservation[]
  companionOf  ReservationGuest[]

  @@index([fullName])
  @@index([docNumber])
}

model RatePlan {
  id                String  @id @default(uuid()) @db.Uuid
  name              String  @unique // "Balcão", "Booking", "Corporativo X"
  includesBreakfast Boolean @default(true)
  // ISS sobre a diária: cobra ou não, e quanto (em centésimos de %: 500 = 5%).
  chargeIss         Boolean @default(false)
  issBasisPoints    Int     @default(500)
  active            Boolean @default(true)

  prices       RatePrice[]
  reservations Reservation[]
}

model RatePrice {
  ratePlanId String @db.Uuid
  roomTypeId String @db.Uuid
  dailyCents Int

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@id([ratePlanId, roomTypeId])
}

enum ReservationStatus {
  CONFIRMADA // ainda não chegou
  HOSPEDADA  // fez check-in: está na casa
  FINALIZADA // fez check-out
  CANCELADA
  NO_SHOW    // não apareceu
}

enum ReservationSource {
  BALCAO
  TELEFONE
  EMAIL
  WHATSAPP
  SITE
  BOOKING
  HOTEIS_COM
  EXPEDIA
  DECOLAR
  AIRBNB
  AGENCIA
  OUTRO
}

model Reservation {
  id             String            @id @default(uuid()) @db.Uuid
  number         Int               @unique @default(autoincrement())
  status         ReservationStatus @default(CONFIRMADA)
  guestId        String            @db.Uuid
  roomTypeId     String            @db.Uuid
  // Quarto escolhido. Obrigatório a partir do check-in.
  roomId         String?           @db.Uuid
  checkIn        DateTime          @db.Date
  checkOut       DateTime          @db.Date
  adults         Int               @default(1)
  children       Int               @default(0)
  ratePlanId     String?           @db.Uuid
  // Valores combinados (copiados da tarifa, podem ser alterados).
  dailyCents     Int
  breakfast      Boolean           @default(true)
  chargeIss      Boolean           @default(false)
  issBasisPoints Int               @default(0)
  source         ReservationSource @default(BALCAO)
  externalCode   String?           // nº da reserva no portal
  notes          String?
  cancelReason   String?
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  checkedInAt    DateTime?
  checkedOutAt   DateTime?

  guest      Guest              @relation(fields: [guestId], references: [id])
  roomType   RoomType           @relation(fields: [roomTypeId], references: [id])
  room       Room?              @relation(fields: [roomId], references: [id])
  ratePlan   RatePlan?          @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation("ReservationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  companions ReservationGuest[]
  events     ReservationEvent[]
  moves      RoomMove[]
  vehicles   Vehicle[]
  folio      FolioEntry[]
  comandas   Comanda[]

  @@index([status, checkIn])
  @@index([status, checkOut])
  @@index([roomId])
  @@index([guestId])
}

// Acompanhantes (o titular fica em Reservation.guestId).
model ReservationGuest {
  reservationId String @db.Uuid
  guestId       String @db.Uuid

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest       Guest       @relation(fields: [guestId], references: [id])

  @@id([reservationId, guestId])
}

// Histórico da reserva: criada, alterada, check-in, troca de quarto...
model ReservationEvent {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @db.Uuid
  userId        String?  @db.Uuid
  type          String
  message       String?
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
}

// Mudança de quarto de um hóspede já na casa (relatório da Fase 6).
model RoomMove {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @db.Uuid
  fromRoomId    String   @db.Uuid
  toRoomId      String   @db.Uuid
  reason        String
  userId        String?  @db.Uuid
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fromRoom    Room        @relation("MoveFrom", fields: [fromRoomId], references: [id])
  toRoom      Room        @relation("MoveTo", fields: [toRoomId], references: [id])
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ================================================================
// GARAGEM (Fase 3)
// ================================================================

model Vehicle {
  id            String    @id @default(uuid()) @db.Uuid
  reservationId String    @db.Uuid
  plate         String
  model         String?
  color         String?
  spot          String?   // vaga
  enteredAt     DateTime  @default(now())
  exitedAt      DateTime?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([exitedAt])
  @@index([plate])
}

// ================================================================
// CONTA DO QUARTO (Fase 4)
// ================================================================
//
// Cada reserva tem uma conta. Lançamentos NUNCA são apagados nem
// alterados: um lançamento errado é ESTORNADO, o que cria um novo
// lançamento com valor negativo apontando para o original.
//
//   saldo = soma das COBRANÇAS - soma dos PAGAMENTOS
//   saldo > 0: hóspede deve · saldo < 0: hóspede tem crédito
//
// businessDate = data do sistema no momento do lançamento (borderô).

enum FolioKind {
  COBRANCA
  PAGAMENTO
}

enum ChargeCategory {
  DIARIA
  ISS
  ESTACIONAMENTO
  FRIGOBAR
  RESTAURANTE
  LAVANDERIA
  TELEFONE
  DANOS
  OUTRO
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CREDITO
  DEBITO
  TRANSFERENCIA
}

model FolioEntry {
  id            String          @id @default(uuid()) @db.Uuid
  reservationId String          @db.Uuid
  kind          FolioKind
  category      ChargeCategory? // cobranças
  method        PaymentMethod?  // pagamentos
  description   String
  quantity      Int             @default(1)
  unitCents     Int?
  amountCents   Int             // negativo = estorno ou devolução
  // Noite a que a diária/ISS/estacionamento se refere (evita lançar duas vezes).
  nightDate     DateTime?       @db.Date
  reference     String?         // NSU, autorização, ID do Pix (NUNCA número de cartão)
  installments  Int?
  isRefund      Boolean         @default(false) // devolução de crédito ao hóspede
  businessDate  DateTime        @db.Date
  createdById   String?         @db.Uuid
  createdAt     DateTime        @default(now())

  // Estorno
  reversalOfId  String?         @unique @db.Uuid
  reversedAt    DateTime?
  reversedById  String?         @db.Uuid
  reverseReason String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  createdBy   User?       @relation("FolioPoster", fields: [createdById], references: [id], onDelete: SetNull)
  reversedBy  User?       @relation("FolioReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  reversalOf  FolioEntry? @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal    FolioEntry? @relation("Reversal")

  @@index([reservationId, createdAt])
  @@index([businessDate, kind])
}

// ================================================================
// RESTAURANTE E FRIGOBAR (Fase 5)
// ================================================================

enum Outlet {
  RESTAURANTE
  FRIGOBAR
}

model MenuItem {
  id         String   @id @default(uuid()) @db.Uuid
  outlet     Outlet
  name       String
  group      String   // "Bebidas", "Pratos", "Sobremesas"...
  priceCents Int
  // Vai para a tela da cozinha? (bebida pronta não precisa)
  kitchen    Boolean  @default(true)
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  comandaItems ComandaItem[]

  @@unique([outlet, name])
  @@index([outlet, active])
}

model DiningTable {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique // "1", "2", "Varanda 1"
  seats  Int     @default(4)
  active Boolean @default(true)

  comandas Comanda[]
}

enum ComandaStatus {
  ABERTA
  FECHADA
  CANCELADA
}

enum ComandaSettlement {
  QUARTO // lançada na conta do quarto
  PAGO   // paga no restaurante
}

// Comanda = a conta de uma mesa, do balcão ou do serviço de quarto.
model Comanda {
  id             String             @id @default(uuid()) @db.Uuid
  number         Int                @unique @default(autoincrement())
  status         ComandaStatus      @default(ABERTA)
  tableId        String?            @db.Uuid
  // Hóspede ligado (serviço de quarto ou quem vai lançar no quarto).
  reservationId  String?            @db.Uuid
  customerName   String?
  people         Int                @default(1)
  serviceFee     Boolean            @default(true)
  serviceFeeBp   Int                @default(1000) // 1000 = 10%
  settlement     ComandaSettlement?
  totalCents     Int?               // gravado ao fechar
  cancelReason   String?
  openedById     String?            @db.Uuid
  closedById     String?            @db.Uuid
  openedAt       DateTime           @default(now())
  closedAt       DateTime?

  table       DiningTable?  @relation(fields: [tableId], references: [id])
  reservation Reservation?  @relation(fields: [reservationId], references: [id])
  openedBy    User?         @relation("ComandaOpener", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy    User?         @relation("ComandaCloser", fields: [closedById], references: [id], onDelete: SetNull)
  items       ComandaItem[]
  payments    PosPayment[]

  @@index([status])
  @@index([closedAt])
}

enum ItemStatus {
  PENDENTE  // pedido feito, cozinha ainda não terminou
  PRONTO    // cozinha terminou, falta levar
  ENTREGUE
  CANCELADO
}

model ComandaItem {
  id           String     @id @default(uuid()) @db.Uuid
  comandaId    String     @db.Uuid
  menuItemId   String     @db.Uuid
  name         String     // cópia do nome no momento do pedido
  unitCents    Int        // cópia do preço no momento do pedido
  quantity     Int
  notes        String?    // "sem cebola"
  kitchen      Boolean
  status       ItemStatus @default(PENDENTE)
  cancelReason String?
  createdById  String?    @db.Uuid
  createdAt    DateTime   @default(now())
  readyAt      DateTime?
  deliveredAt  DateTime?

  comanda   Comanda  @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  menuItem  MenuItem @relation(fields: [menuItemId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([comandaId])
  @@index([status, kitchen])
}

// Pagamento feito direto no restaurante (cliente de fora ou hóspede que
// preferiu pagar na hora). Entra no borderô do Financeiro.
model PosPayment {
  id           String        @id @default(uuid()) @db.Uuid
  comandaId    String        @db.Uuid
  method       PaymentMethod
  amountCents  Int
  reference    String?
  businessDate DateTime      @db.Date
  createdById  String?       @db.Uuid
  createdAt    DateTime      @default(now())

  comanda   Comanda @relation(fields: [comandaId], references: [id], onDelete: Restrict)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessDate])
}
